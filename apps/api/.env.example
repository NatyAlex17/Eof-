# .env.example — safe template with comments
# Copy this file to `.env` and replace placeholder values with real secrets.
# Do NOT commit a filled `.env` to source control. Add `.env` to .gitignore.

# Application environment (development | production | test)
NODE_ENV=development

# Application port
PORT=4000

# Postgres connection URL. Replace the password and host for production.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:REPLACE_DB_PASSWORD@localhost:5432/class_pulse

# JWT secrets: use long, random values (>=32 chars). Keep these private.
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_32_PLUS_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET_32_PLUS_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS origin allowed for browser requests (your frontend URL)
CORS_ORIGIN=http://localhost:3000

# Storage driver: 'local' for disk, 's3' for AWS S3 (add S3 vars when using s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=uploads

# Email provider settings. Set EMAIL_PROVIDER=none to disable email features.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Notes:
# - Use environment-specific secret management in production (Vault, AWS Secrets Manager, etc.).
# - Ensure the DB user has limited privileges in production.
# - Enable TLS/SSL for production DB connections when supported.