# ============================================================
# apps/web — environment variables
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real secrets.
# ============================================================

# Supabase project — get these from:
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Service role key — server-side only (never expose to the browser)
# Used by: /api/admin/invite (inviting users via Supabase Auth Admin API)
# Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
