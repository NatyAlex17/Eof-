{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "eof-mana",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "eslint . --fix",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "build:web": "pnpm --filter ./apps/web build",
    "build:api": "pnpm --filter ./apps/api build",
    "db:migrate": "pnpm --filter ./apps/api prisma:migrate",
    "db:generate": "pnpm --filter ./apps/api prisma:generate",
    "db:seed": "pnpm --filter ./apps/api prisma:seed",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.18.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "lint-staged": "^17.0.7"
  }
}
