#!/bin/sh

if ! pnpm exec commitlint --edit "$1"; then
  printf "\n"
  printf "─────────────────────────────────────────────────────\n"
  printf " COMMIT FORMAT:  type(scope): subject\n"
  printf "─────────────────────────────────────────────────────\n"
  printf "\n"
  printf " TYPES\n"
  printf "   feat       new feature\n"
  printf "   fix        bug fix\n"
  printf "   refactor   code change without behavior change\n"
  printf "   test       tests\n"
  printf "   docs       documentation\n"
  printf "   chore      maintenance/config\n"
  printf "   ci         CI/CD changes\n"
  printf "   perf       performance improvement\n"
  printf "   style      formatting only\n"
  printf "   revert     revert previous change\n"
  printf "\n"
  printf " SCOPES\n"
  printf "   auth, users, roles, customers, vendors, products,\n"
  printf "   skus, inventory, lots, boxes, orders, allocations,\n"
  printf "   shipments, logistics, bol, packing-slips, invoices,\n"
  printf "   credits, reconciliation, commissions, margins,\n"
  printf "   quickbooks, hubspot, fresho, sheets, email-parser,\n"
  printf "   notifications, dashboards, reports, forecasting,\n"
  printf "   migration, mana-transition, audit, api, web,\n"
  printf "   workers, infra, docs, shared, root\n"
  printf "\n"
  printf " RULES\n"
  printf "   - type and scope must be lowercase\n"
  printf "   - subject must be lowercase, no trailing period\n"
  printf "   - scope is required (empty parens not allowed)\n"
  printf "\n"
  printf " EXAMPLES\n"
  printf "   feat(orders): add bulk order creation endpoint\n"
  printf "   fix(auth): resolve token expiry on refresh\n"
  printf "   chore(root): update eslint config\n"
  printf "   refactor(shared): simplify date formatting util\n"
  printf "─────────────────────────────────────────────────────\n"
  exit 1
fi
